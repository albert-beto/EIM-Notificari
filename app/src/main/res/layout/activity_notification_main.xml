<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="16dp">

    <!-- textul care va aparea in notificare -->
    <EditText
        android:id="@+id/EditTextMessage"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="mesajul notificarii" />

    <!-- trei butoane egale: cate unul pentru fiecare mod de a trimite notificarea -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <Button
            android:id="@+id/ButtonNotify"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Notify" />

        <Button
            android:id="@+id/ButtonBroadcast"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Broadcast" />

        <Button
            android:id="@+id/ButtonService"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Service" />
    </LinearLayout>
</LinearLayout>
